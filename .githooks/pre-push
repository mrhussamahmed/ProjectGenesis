#!/usr/bin/env bash
set -euo pipefail

# Adaptive routing: pre-push reads the same local `.ai/SESSION.md` profile
# hint as pre-commit, falling back to legacy AI_HANDOFF.md profile extraction.
# Push validation defaults to strict; a docs-trivial or process-light-exception
# profile only relaxes pre-push checks when the pushed branch contains no
# strict-gate path changes vs origin/main.

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$repo_root"

validator_level="strict"
if [[ -x SCRIPTS/operation-profile.sh ]]; then
  validator_level="$(bash SCRIPTS/operation-profile.sh --validator-level)"
fi

# The strict-gate pattern's single source of truth is
# SCRIPTS/strict-gate-paths.sh (also consumed by pre-commit and CI). If the
# helper is missing or prints nothing, fail closed: run strict.
strict_gate_pattern=""
if [[ -x SCRIPTS/strict-gate-paths.sh ]]; then
  strict_gate_pattern="$(bash SCRIPTS/strict-gate-paths.sh --regex 2>/dev/null || true)"
fi
if [[ -z "$strict_gate_pattern" && "$validator_level" != "strict" ]]; then
  echo "pre-push: SCRIPTS/strict-gate-paths.sh unavailable; failing closed to BOOTSTRAP_VALIDATE_PROFILE=strict." >&2
  validator_level="strict"
fi

if [[ "$validator_level" != "strict" ]]; then
  if git rev-parse --verify origin/main >/dev/null 2>&1; then
    changed_files="$(git diff --name-only origin/main...HEAD 2>/dev/null || true)"
    if [[ -n "$changed_files" ]] && echo "$changed_files" | grep -Eq "$strict_gate_pattern"; then
      echo "pre-push: strict gate touched on branch; forcing BOOTSTRAP_VALIDATE_PROFILE=strict regardless of recorded Operation profile ($validator_level)." >&2
      validator_level="strict"
    fi
  else
    echo "pre-push: origin/main not resolvable; cannot prove the diff avoids strict-gate paths. Failing closed to BOOTSTRAP_VALIDATE_PROFILE=strict." >&2
    validator_level="strict"
  fi
fi

export BOOTSTRAP_VALIDATE_PROFILE="$validator_level"
bash SCRIPTS/validate-bootstrap.sh

echo "pre-push checks passed (validator profile: $validator_level)"
