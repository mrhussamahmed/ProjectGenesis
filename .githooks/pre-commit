#!/usr/bin/env bash
set -euo pipefail

# Adaptive routing: read the local `.ai/SESSION.md` operation profile hint,
# falling back to legacy AI_HANDOFF.md profile extraction. If the profile
# indicates a docs-trivial or process-light-exception change AND the staged
# file set does not touch any strict-gate path (validators, CI, security,
# hooks, governance, role instructions, reusable templates), the validator
# runs in shape-only mode. Otherwise the validator runs in strict mode.
# Default is strict, so a missing or stale local session never weakens
# validation.

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$repo_root"

validator_level="strict"
if [[ -x SCRIPTS/operation-profile.sh ]]; then
  validator_level="$(bash SCRIPTS/operation-profile.sh --validator-level)"
fi

# Strict gates: if any staged file matches these patterns the validator
# must run strict regardless of the recorded profile.
strict_gate_pattern='^(SCRIPTS/|\.github/workflows/|\.githooks/|memory/ai/|PR_REVIEW_POLICY\.md|PR_MERGE_POLICY\.md|RISK_MODEL\.md|BRANCH_AND_WORKTREE_GUIDE\.md|GOVERNANCE\.md|OPERATION_ROUTING\.md|CONTEXT_PACKS/|COMMANDS/|REVIEWS/templates/|SPECS/templates/|ADR/templates/|BACKLOG/templates/|TEMPLATE_MANIFEST\.md|TEMPLATE_STARTERS/|HOOKS_AND_GUARDRAILS\.md|SECURITY_AND_PRIVACY\.md|CI_CD_GUIDE\.md|MAINTAINER_ARCHIVE/)'

if [[ "$validator_level" != "strict" ]] && git rev-parse --git-dir >/dev/null 2>&1; then
  # Include deletions (D) so that removing a strict-gate path also forces
  # strict — a deletion of GOVERNANCE.md, a script, a hook, a template,
  # or a context pack is itself a strict-gate-touching change.
  if git diff --cached --name-only --diff-filter=ACMRD 2>/dev/null | grep -Eq "$strict_gate_pattern"; then
    echo "pre-commit: strict gate touched (including deletions); forcing BOOTSTRAP_VALIDATE_PROFILE=strict regardless of recorded Operation profile ($validator_level)." >&2
    validator_level="strict"
  fi
fi

export BOOTSTRAP_VALIDATE_PROFILE="$validator_level"
bash SCRIPTS/validate-bootstrap.sh

if git rev-parse --git-dir >/dev/null 2>&1; then
  private_key_pattern='BEGIN (RSA|DSA|EC|OPENSSH) PRIVATE'' KEY'
  openai_key_pattern='OPENAI_API_''KEY='
  anthropic_key_pattern='ANTHROPIC_API_''KEY='
  token_pattern='s''k-[A-Za-z0-9_-]{20,}'
  secret_pattern="${private_key_pattern}|${openai_key_pattern}|${anthropic_key_pattern}|${token_pattern}"
  staged_tmp="$(mktemp)"
  git diff --cached --name-only -z --diff-filter=ACM > "$staged_tmp"
  if [[ -s "$staged_tmp" ]]; then
    if xargs -0 grep -InE "$secret_pattern" < "$staged_tmp" >/tmp/precommit-secret-hit.$$ 2>/dev/null; then
      echo "Potential secret detected in staged files:" >&2
      cat /tmp/precommit-secret-hit.$$ >&2
      rm -f /tmp/precommit-secret-hit.$$
      rm -f "$staged_tmp"
      exit 1
    fi
    rm -f /tmp/precommit-secret-hit.$$
  fi
  rm -f "$staged_tmp"
fi

echo "pre-commit checks passed (validator profile: $validator_level)"
