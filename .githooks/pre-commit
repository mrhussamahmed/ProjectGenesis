#!/usr/bin/env bash
set -euo pipefail

# Adaptive routing: read the local `.ai/SESSION.md` operation profile hint,
# falling back to legacy AI_HANDOFF.md profile extraction. If the profile
# indicates a docs-trivial or process-light-exception change AND the staged
# file set does not touch any strict-gate path (validators, CI, security,
# hooks, governance, role instructions, reusable templates), the validator
# runs in shape-only mode. Otherwise the validator runs in strict mode.
# Default is strict, so a missing or stale local session never weakens
# validation.

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$repo_root"

validator_level="strict"
if [[ -x SCRIPTS/operation-profile.sh ]]; then
  validator_level="$(bash SCRIPTS/operation-profile.sh --validator-level)"
fi

# Strict gates: if any staged file matches the strict-gate pattern the
# validator must run strict regardless of the recorded profile. The pattern's
# single source of truth is SCRIPTS/strict-gate-paths.sh (also consumed by
# pre-push and CI). If the helper is missing or prints nothing, fail closed:
# run strict.
strict_gate_pattern=""
if [[ -x SCRIPTS/strict-gate-paths.sh ]]; then
  strict_gate_pattern="$(bash SCRIPTS/strict-gate-paths.sh --regex 2>/dev/null || true)"
fi
if [[ -z "$strict_gate_pattern" && "$validator_level" != "strict" ]]; then
  echo "pre-commit: SCRIPTS/strict-gate-paths.sh unavailable; failing closed to BOOTSTRAP_VALIDATE_PROFILE=strict." >&2
  validator_level="strict"
fi

if [[ "$validator_level" != "strict" ]] && git rev-parse --git-dir >/dev/null 2>&1; then
  # Include deletions (D) so that removing a strict-gate path also forces
  # strict — a deletion of GOVERNANCE.md, a script, a hook, a template,
  # or a context pack is itself a strict-gate-touching change.
  if git diff --cached --name-only --diff-filter=ACMRD 2>/dev/null | grep -Eq "$strict_gate_pattern"; then
    echo "pre-commit: strict gate touched (including deletions); forcing BOOTSTRAP_VALIDATE_PROFILE=strict regardless of recorded Operation profile ($validator_level)." >&2
    validator_level="strict"
  fi
fi

export BOOTSTRAP_VALIDATE_PROFILE="$validator_level"
# GEN-17/AUTO-6: in the shape-only fast path, scope the validator's
# metadata scan to the staged file set the strict-gate check already
# cleared. Strict and state-sync runs keep the full scan.
if [[ "$validator_level" == "shape-only" ]]; then
  BOOTSTRAP_CHANGED_FILES="$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null || true)"
  export BOOTSTRAP_CHANGED_FILES
fi
bash SCRIPTS/validate-bootstrap.sh

if git rev-parse --git-dir >/dev/null 2>&1; then
  private_key_pattern='BEGIN (RSA|DSA|EC|OPENSSH) PRIVATE'' KEY'
  openai_key_pattern='OPENAI_API_''KEY='
  anthropic_key_pattern='ANTHROPIC_API_''KEY='
  token_pattern='s''k-[A-Za-z0-9_-]{20,}'
  secret_pattern="${private_key_pattern}|${openai_key_pattern}|${anthropic_key_pattern}|${token_pattern}"

  # Secret scan hygiene (GEN-17/AUTO-7):
  # - Scan the staged blob (`git show :path`), not the worktree copy: the
  #   commit contains the staged content, and the worktree file may differ
  #   from what is actually being committed or may have been deleted.
  # - Use mktemp-managed files only; never predictable /tmp/<name>.$$ paths.
  # - Fail closed: a git or grep failure (grep exit status > 1) blocks the
  #   commit instead of silently skipping the scan.
  secret_hits_tmp="$(mktemp)"
  secret_scan_error=0
  trap 'rm -f "$secret_hits_tmp"' EXIT
  while IFS= read -r -d '' staged_path; do
    set +e
    git show ":$staged_path" 2>/dev/null \
      | grep -InE "$secret_pattern" \
      | sed "s|^|$staged_path:|" >> "$secret_hits_tmp"
    pipe_status=("${PIPESTATUS[@]}")
    set -e
    show_status="${pipe_status[0]}"
    grep_status="${pipe_status[1]}"
    if [[ "$show_status" -ne 0 ]]; then
      echo "pre-commit: cannot read staged blob for '$staged_path'; failing closed." >&2
      secret_scan_error=1
    fi
    if [[ "$grep_status" -gt 1 ]]; then
      echo "pre-commit: secret scan grep error (exit $grep_status) on '$staged_path'; failing closed." >&2
      secret_scan_error=1
    fi
  done < <(git diff --cached --name-only -z --diff-filter=ACM)
  if [[ -s "$secret_hits_tmp" ]]; then
    echo "Potential secret detected in staged files:" >&2
    cat "$secret_hits_tmp" >&2
    exit 1
  fi
  if [[ "$secret_scan_error" -ne 0 ]]; then
    echo "pre-commit: secret scan could not verify all staged blobs; commit blocked (fail-closed)." >&2
    exit 1
  fi
fi

echo "pre-commit checks passed (validator profile: $validator_level)"
